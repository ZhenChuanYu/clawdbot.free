---
import { tPlatforms, type Locale } from '../i18n/grok-api-free-translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getLocalizedPath(path: string, locale: Locale) {
  const normalizedPath = path === '/' ? '/' : (path.endsWith('/') ? path : `${path}/`);
  if (locale === 'en') return normalizedPath;
  const pathWithoutSlash = normalizedPath === '/' ? '' : normalizedPath;
  return `/${locale}${pathWithoutSlash}`;
}

const homePath = getLocalizedPath('/', locale);

const platforms = [
  {
    id: 'aiberm',
    titleKey: 'platform_aiberm_title',
    descKey: 'platform_aiberm_desc',
    pricingKey: 'platform_aiberm_pricing',
    freeTierKey: 'platform_aiberm_freeTier',
    featuresKey: 'platform_aiberm_features',
    linkKey: 'platform_aiberm_link',
    gradient: 'from-red-600 to-orange-600',
  },
  {
    id: 'xai',
    titleKey: 'platform_xai_title',
    descKey: 'platform_xai_desc',
    pricingKey: 'platform_xai_pricing',
    freeTierKey: 'platform_xai_freeTier',
    featuresKey: 'platform_xai_features',
    linkKey: 'platform_xai_link',
    gradient: 'from-gray-900 to-gray-800',
  },
  {
    id: 'laozhang',
    titleKey: 'platform_laozhang_title',
    descKey: 'platform_laozhang_desc',
    pricingKey: 'platform_laozhang_pricing',
    freeTierKey: 'platform_laozhang_freeTier',
    featuresKey: 'platform_laozhang_features',
    linkKey: 'platform_laozhang_link',
    gradient: 'from-green-600 to-emerald-600',
  },
  {
    id: 'gxgapi',
    titleKey: 'platform_gxgapi_title',
    descKey: 'platform_gxgapi_desc',
    pricingKey: 'platform_gxgapi_pricing',
    freeTierKey: 'platform_gxgapi_freeTier',
    featuresKey: 'platform_gxgapi_features',
    linkKey: 'platform_gxgapi_link',
    gradient: 'from-blue-600 to-cyan-600',
  },
  {
    id: 'elven',
    titleKey: 'platform_elven_title',
    descKey: 'platform_elven_desc',
    pricingKey: 'platform_elven_pricing',
    freeTierKey: 'platform_elven_freeTier',
    featuresKey: 'platform_elven_features',
    linkKey: 'platform_elven_link',
    gradient: 'from-purple-600 to-pink-600',
  },
  {
    id: 'apiyi',
    titleKey: 'platform_apiyi_title',
    descKey: 'platform_apiyi_desc',
    pricingKey: 'platform_apiyi_pricing',
    freeTierKey: 'platform_apiyi_freeTier',
    featuresKey: 'platform_apiyi_features',
    linkKey: 'platform_apiyi_link',
    gradient: 'from-orange-600 to-red-600',
  },
  {
    id: 'comet',
    titleKey: 'platform_comet_title',
    descKey: 'platform_comet_desc',
    pricingKey: 'platform_comet_pricing',
    freeTierKey: 'platform_comet_freeTier',
    featuresKey: 'platform_comet_features',
    linkKey: 'platform_comet_link',
    gradient: 'from-indigo-600 to-purple-600',
  },
  {
    id: 'azure',
    titleKey: 'platform_azure_title',
    descKey: 'platform_azure_desc',
    pricingKey: 'platform_azure_pricing',
    freeTierKey: 'platform_azure_freeTier',
    featuresKey: 'platform_azure_features',
    linkKey: 'platform_azure_link',
    gradient: 'from-blue-700 to-blue-800',
  },
  {
    id: 'aws',
    titleKey: 'platform_aws_title',
    descKey: 'platform_aws_desc',
    pricingKey: 'platform_aws_pricing',
    freeTierKey: 'platform_aws_freeTier',
    featuresKey: 'platform_aws_features',
    linkKey: 'platform_aws_link',
    gradient: 'from-orange-500 to-orange-600',
  },
  {
    id: 'oracle',
    titleKey: 'platform_oracle_title',
    descKey: 'platform_oracle_desc',
    pricingKey: 'platform_oracle_pricing',
    freeTierKey: 'platform_oracle_freeTier',
    featuresKey: 'platform_oracle_features',
    linkKey: 'platform_oracle_link',
    gradient: 'from-red-600 to-red-700',
  },
  {
    id: 'github',
    titleKey: 'platform_github_title',
    descKey: 'platform_github_desc',
    pricingKey: 'platform_github_pricing',
    freeTierKey: 'platform_github_freeTier',
    featuresKey: 'platform_github_features',
    linkKey: 'platform_github_link',
    gradient: 'from-gray-800 to-gray-900',
  },
];

const faqItems = [
  { qKey: 'faq_q1', aKey: 'faq_a1' },
  { qKey: 'faq_q2', aKey: 'faq_a2' },
  { qKey: 'faq_q3', aKey: 'faq_a3' },
  { qKey: 'faq_q4', aKey: 'faq_a4' },
  { qKey: 'faq_q5', aKey: 'faq_a5' },
];
---

<div class="relative">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-white via-gray-50 to-white">
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-32">
      <!-- Back to Home Link -->
      <div class="mb-8">
        <a
          href={homePath}
          class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {t(locale, 'common_backToHome')}
        </a>
      </div>
      <div class="text-center">
        <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 tracking-tight leading-none">
          {tPlatforms(locale, 'hero_title')}
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-700 mb-4 font-light max-w-3xl mx-auto">
          {tPlatforms(locale, 'hero_subtitle')}
        </p>

        <p class="text-base md:text-lg text-gray-700 mb-8 font-light max-w-2xl mx-auto leading-relaxed">
          {tPlatforms(locale, 'hero_description')}
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison Table Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-700 mb-3 uppercase tracking-wide">
          {tPlatforms(locale, 'comparison_title')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {tPlatforms(locale, 'section_title')}
        </h2>
        <p class="text-lg text-gray-700 font-light">
          {tPlatforms(locale, 'comparison_subtitle')}
        </p>
      </div>

      <!-- Desktop Table -->
      <div class="hidden lg:block overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b-2 border-gray-200">
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{tPlatforms(locale, 'table_platform')}</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{tPlatforms(locale, 'table_pricing')}</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{tPlatforms(locale, 'table_freeTier')}</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{tPlatforms(locale, 'table_features')}</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{tPlatforms(locale, 'table_link')}</th>
            </tr>
          </thead>
          <tbody>
            {platforms.map((platform) => (
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-semibold text-gray-900">{tPlatforms(locale, platform.titleKey)}</div>
                  <div class="text-sm text-gray-700 mt-1">{tPlatforms(locale, platform.descKey)}</div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 font-medium">{tPlatforms(locale, platform.pricingKey)}</td>
                <td class="px-6 py-4 text-sm text-gray-700">{tPlatforms(locale, platform.freeTierKey)}</td>
                <td class="px-6 py-4 text-sm text-gray-700">{tPlatforms(locale, platform.featuresKey)}</td>
                <td class="px-6 py-4">
                  <a
                    href={tPlatforms(locale, platform.linkKey)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all text-sm font-medium"
                  >
                    {tPlatforms(locale, 'table_link')}
                    <span>→</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="lg:hidden space-y-6">
        {platforms.map((platform) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-all">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{tPlatforms(locale, platform.titleKey)}</h3>
            <p class="text-sm text-gray-700 mb-4">{tPlatforms(locale, platform.descKey)}</p>
            
            <div class="space-y-3 mb-4">
              <div class="flex justify-between">
                <span class="text-sm text-gray-700 font-medium">{tPlatforms(locale, 'table_pricing')}:</span>
                <span class="text-sm font-medium text-gray-900">{tPlatforms(locale, platform.pricingKey)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-700 font-medium">{tPlatforms(locale, 'table_freeTier')}:</span>
                <span class="text-sm text-gray-900">{tPlatforms(locale, platform.freeTierKey)}</span>
              </div>
              <div>
                <span class="text-sm text-gray-700 font-medium">{tPlatforms(locale, 'table_features')}:</span>
                <p class="text-sm text-gray-900 mt-1">{tPlatforms(locale, platform.featuresKey)}</p>
              </div>
            </div>

            <a
              href={tPlatforms(locale, platform.linkKey)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all text-sm font-medium w-full justify-center"
            >
              {tPlatforms(locale, 'table_link')}
              <span>→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guide Section -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-700 mb-3 uppercase tracking-wide">
          {tPlatforms(locale, 'guide_title')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {tPlatforms(locale, 'guide_title')}
        </h2>
        <p class="text-lg text-gray-700 font-light">
          {tPlatforms(locale, 'guide_subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white border border-gray-200 rounded-2xl">
          <h3 class="text-lg font-bold text-gray-900 mb-3">{tPlatforms(locale, 'guide_budget')}</h3>
          <p class="text-sm text-gray-700">{tPlatforms(locale, 'guide_budget_desc')}</p>
        </div>
        <div class="p-6 bg-white border border-gray-200 rounded-2xl">
          <h3 class="text-lg font-bold text-gray-900 mb-3">{tPlatforms(locale, 'guide_enterprise')}</h3>
          <p class="text-sm text-gray-700">{tPlatforms(locale, 'guide_enterprise_desc')}</p>
        </div>
        <div class="p-6 bg-white border border-gray-200 rounded-2xl">
          <h3 class="text-lg font-bold text-gray-900 mb-3">{tPlatforms(locale, 'guide_china')}</h3>
          <p class="text-sm text-gray-700">{tPlatforms(locale, 'guide_china_desc')}</p>
        </div>
        <div class="p-6 bg-white border border-gray-200 rounded-2xl">
          <h3 class="text-lg font-bold text-gray-900 mb-3">{tPlatforms(locale, 'guide_official')}</h3>
          <p class="text-sm text-gray-700">{tPlatforms(locale, 'guide_official_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-700 mb-3 uppercase tracking-wide">
          {tPlatforms(locale, 'faq_title')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {tPlatforms(locale, 'faq_title')}
        </h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {faqItems.map((item) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition-colors">
              <h3 class="text-lg font-semibold text-gray-900 pr-4">{tPlatforms(locale, item.qKey)}</h3>
              <svg class="w-5 h-5 text-gray-700 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-6">
              <p class="text-gray-700 leading-relaxed">{tPlatforms(locale, item.aKey)}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</div>

