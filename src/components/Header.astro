---
import { t, type Locale, localeNames } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getLocalizedPath(path: string, locale: Locale) {
  if (locale === 'en') return path;
  return `/${locale}${path === '/' ? '' : path}`;
}

const homePath = getLocalizedPath('/', locale);
---

<header class="fixed top-0 left-0 right-0 z-50 glass-effect">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={homePath} class="flex items-center gap-2 group" title="Grok API Home">
        <span class="text-base font-semibold text-gray-900 tracking-tight">Grok API</span>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center gap-1">
        <a
          href={homePath}
          class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-all"
          title="Grok API Home"
        >
          {t(locale, 'common_home')}
        </a>
        <a
          href="#features"
          class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-all"
          title="Grok API Features"
        >
          {t(locale, 'common_features')}
        </a>
        <a
          href="#resources"
          class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-all"
          title="Grok API Resources"
        >
          Resources
        </a>
        <a
          href="#faq"
          class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-all"
          title="Grok API FAQ"
        >
          {t(locale, 'common_faq')}
        </a>
      </nav>

      <!-- Language Switcher -->
      <div class="flex items-center gap-3">
        <div class="relative">
          <select 
            id="lang-switcher"
            class="appearance-none bg-gray-50 border border-gray-200 rounded-lg px-3 py-1.5 text-sm text-gray-700 cursor-pointer hover:bg-gray-100 transition-colors pr-8"
          >
            <option value="en" selected={locale === 'en'}>English</option>
            <option value="zh" selected={locale === 'zh'}>中文</option>
            <option value="zh-tw" selected={locale === 'zh-tw'}>繁體中文</option>
          </select>
          <svg class="absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const switcher = document.getElementById('lang-switcher') as HTMLSelectElement;
  if (switcher) {
    switcher.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const newLocale = target.value;
      const currentPath = window.location.pathname;
      
      // Remove current locale prefix
      let basePath = currentPath.replace(/^\/(zh-tw|zh)(\/|$)/, '/');
      if (basePath === '') basePath = '/';
      
      // Add new locale prefix
      let newPath: string;
      if (newLocale === 'en') {
        newPath = basePath;
      } else {
        newPath = `/${newLocale}${basePath === '/' ? '' : basePath}`;
      }
      
      window.location.href = newPath;
    });
  }
</script>
