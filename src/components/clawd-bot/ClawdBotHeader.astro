---
/**
 * ClawdBot 导航头部组件
 */
import { tClawdbotHome, type ClawdbotHomeLocale } from '../../i18n/clawdbot-home-translations';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const localeKey = (locale === 'zh-tw' ? 'zh-tw' : locale) as ClawdbotHomeLocale;
const t = (key: string) => tClawdbotHome(localeKey, key);

const navLinks = [
  { href: '#features', labelKey: 'header_nav_features' },
  { href: '#install', labelKey: 'header_nav_install' },
  { href: '#about', labelKey: 'header_nav_about' },
  { href: 'https://docs.clawd.bot', labelKey: 'header_nav_docs', external: true },
];

const languages = [
  { code: 'en', label: 'EN', path: '/' },
  { code: 'zh', label: '中文', path: '/zh/' },
  { code: 'zh-tw', label: '繁體中文', path: '/zh-tw/' },
  { code: 'ja', label: '日本語', path: '/ja/' },
  { code: 'ko', label: '한국어', path: '/ko/' },
  { code: 'es', label: 'ES', path: '/es/' },
  { code: 'de', label: 'DE', path: '/de/' },
  { code: 'fr', label: 'FR', path: '/fr/' },
  { code: 'pt', label: 'PT', path: '/pt/' },
  { code: 'ru', label: 'RU', path: '/ru/' },
  { code: 'hi', label: 'हिन्दी', path: '/hi/' },
];
---

<header class="clawd-header">
  <div class="clawd-container">
    <nav class="clawd-nav">
      <!-- Logo -->
      <a href="/" class="clawd-logo" title={t('header_logo_title')}>
        <span class="clawd-logo-icon">🦞</span>
        <span class="clawd-logo-text">ClawdBot</span>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="clawd-nav-links">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class="clawd-nav-link" 
            title={t(link.labelKey)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {t(link.labelKey)}
          </a>
        ))}
      </div>
      
      <!-- Right Section -->
      <div class="clawd-nav-right">
        <!-- Language Selector -->
        <div class="clawd-lang-selector">
          <button class="clawd-lang-btn" aria-label={t('header_aria_lang')}>
            {languages.find(l => l.code === locale)?.label || 'EN'}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
          </button>
          <div class="clawd-lang-dropdown">
            {languages.map(lang => (
              <a 
                href={lang.path} 
                class={`clawd-lang-option ${lang.code === locale ? 'active' : ''}`}
                title={`${t('header_switch_lang')} ${lang.label}`}
              >
                {lang.label}
              </a>
            ))}
          </div>
        </div>
        
        <!-- GitHub Link -->
        <a 
          href="https://docs.clawd.bot" 
          target="_blank" 
          rel="noopener noreferrer"
          class="clawd-github-link"
          title="ClawdBot Documentation"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </a>
        
        <!-- Mobile Menu Button -->
        <button class="clawd-menu-btn" aria-label={t('header_aria_menu')}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
  
  <!-- Mobile Menu -->
  <div class="clawd-mobile-menu">
    <div class="clawd-mobile-links">
      {navLinks.map(link => (
        <a href={link.href} class="clawd-mobile-link" title={t(link.labelKey)}>
          {t(link.labelKey)}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .clawd-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(5, 8, 16, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .clawd-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  
  .clawd-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
  }
  
  .clawd-logo-icon {
    font-size: 1.5rem;
  }
  
  .clawd-logo:hover .clawd-logo-text {
    color: var(--coral-bright);
  }
  
  .clawd-nav-links {
    display: flex;
    gap: 2rem;
  }
  
  .clawd-nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  
  .clawd-nav-link:hover {
    color: var(--coral-bright);
  }
  
  .clawd-nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .clawd-lang-selector {
    position: relative;
  }
  
  .clawd-lang-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .clawd-lang-btn:hover {
    border-color: var(--coral-bright);
    color: var(--text-primary);
  }
  
  .clawd-lang-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    min-width: 100px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all var(--transition-fast);
  }
  
  .clawd-lang-selector:hover .clawd-lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .clawd-lang-option {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }
  
  .clawd-lang-option:hover,
  .clawd-lang-option.active {
    background: var(--bg-surface);
    color: var(--coral-bright);
  }
  
  .clawd-github-link {
    display: flex;
    align-items: center;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }
  
  .clawd-github-link:hover {
    color: var(--text-primary);
  }
  
  .clawd-menu-btn {
    display: none;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  
  .clawd-mobile-menu {
    display: none;
    padding: 1rem;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }
  
  .clawd-mobile-link {
    display: block;
    padding: 0.75rem 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .clawd-mobile-link:hover {
    color: var(--coral-bright);
  }
  
  @media (max-width: 768px) {
    .clawd-nav-links {
      display: none;
    }
    
    .clawd-menu-btn {
      display: flex;
    }
    
    .clawd-mobile-menu.active {
      display: block;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const menuBtn = document.querySelector('.clawd-menu-btn');
  const mobileMenu = document.querySelector('.clawd-mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('active');
  });
  
  // Close mobile menu on link click
  const mobileLinks = document.querySelectorAll('.clawd-mobile-link');
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
    });
  });
</script>

