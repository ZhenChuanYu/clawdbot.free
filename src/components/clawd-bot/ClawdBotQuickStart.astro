const t = content[locale as keyof typeof content] || content.en;
---

<section class="clawd-quick-start" id="quick-start">
  <div class="clawd-container">
    <!-- Section Header -->
    <div class="clawd-section-header">
      <span class="clawd-section-prefix">{t.sectionPrefix}</span>
      <h2 class="clawd-heading-2">{t.sectionTitle}</h2>
    </div>
    <p class="clawd-section-subtitle">{t.subtitle}</p>
    
    <!-- Installation Method Selector -->
    <div class="clawd-install-methods">
      {t.installMethods?.map((method) => (
        <button class={`clawd-method-btn ${method.active ? 'active' : ''}`}>
          {method.name}
        </button>
      ))}
    </div>
    
    <!-- One-liner Installation -->
    <div class="clawd-install-section">
      <div class="clawd-install-header">
        <p class="clawd-install-comment"># {locale === 'zh' ? '适用于所有平台。自动安装所有依赖。不客气。🦞' : locale === 'zh-tw' ? '適用於所有平台。自動安裝所有依賴。不客氣。🦞' : locale === 'ja' ? 'どこでも動作。すべてをインストール。どういたしまして。🦞' : locale === 'ko' ? '어디서나 작동합니다. 모든 것을 설치합니다. 천만에요. 🦞' : locale === 'es' ? 'Funciona en todas partes. Instala todo. De nada. 🦞' : locale === 'de' ? 'Funktioniert überall. Installiert alles. Bitte schön. 🦞' : locale === 'fr' ? 'Fonctionne partout. Installe tout. De rien. 🦞' : locale === 'pt' ? 'Funciona em todos os lugares. Instala tudo. De nada. 🦞' : locale === 'ru' ? 'Работает везде. Устанавливает всё. Пожалуйста. 🦞' : locale === 'hi' ? 'हर जगह काम करता है। सब कुछ स्थापित करता है। आपका स्वागत है। 🦞' : "Works everywhere. Installs everything. You're welcome. 🦞"}</p>
      </div>
      <div class="clawd-install-code-block">
        <span class="clawd-prompt">$</span>
        <code class="clawd-install-command">{t.oneLinerCommand}</code>
        <button class="clawd-copy-btn" data-command={t.oneLinerCommand} title="Copy to clipboard">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M4 4v-1.5c0-.828.672-1.5 1.5-1.5h6c.828 0 1.5.672 1.5 1.5v8c0 .828-.672 1.5-1.5 1.5h-1.5m-6-8h-1.5c-.828 0-1.5.672-1.5 1.5v8c0 .828.672 1.5 1.5 1.5h6c.828 0 1.5-.672 1.5-1.5v-1.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </button>
      </div>
      <p class="clawd-install-description">{t.oneLinerDescription}</p>
    </div>
    
    <!-- CTAs -->
    <div class="clawd-quick-start-cta">
      <a href="https://docs.clawd.bot" target="_blank" rel="noopener noreferrer" class="clawd-btn clawd-btn-secondary" title="Read Clawd Bot full documentation - Clawd Bot guide">
        {t.docsLink}
      </a>
      <a href="https://clawd.bot/download" target="_blank" rel="noopener noreferrer" class="clawd-btn clawd-btn-primary" title="Download Clawd Bot - Get Clawd Bot now">
        {t.downloadLink}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 1v10M4 7l4 4 4-4M2 14h12" stroke="currentColor" stroke-width="2" fill="none"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .clawd-quick-start {
    padding: 6rem 0;
    background: var(--bg-deep);
  }
  
  .clawd-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  
  .clawd-section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 3rem;
  }
  
  .clawd-install-methods {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  
  .clawd-method-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .clawd-method-btn:hover {
    border-color: var(--border-default);
    color: var(--text-primary);
  }
  
  .clawd-method-btn.active {
    background: var(--bg-surface);
    border-color: var(--coral-bright);
    color: var(--coral-bright);
  }
  
  .clawd-install-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 2rem;
    margin-bottom: 2rem;
  }
  
  .clawd-install-header {
    margin-bottom: 1rem;
  }
  
  .clawd-install-comment {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  .clawd-install-code-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  
  .clawd-prompt {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
    user-select: none;
  }
  
  .clawd-install-command {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--cyan-bright);
    background: none;
    border: none;
  }
  
  .clawd-install-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  
  .clawd-copy-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color var(--transition-fast);
  }
  
  .clawd-copy-btn:hover {
    color: var(--coral-bright);
  }
  
  .clawd-quick-start-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  
  @media (max-width: 640px) {
    .clawd-quick-start {
      padding: 4rem 0;
    }
    
    .clawd-install-code-block {
      flex-wrap: wrap;
    }
    
    .clawd-install-command {
      word-break: break-all;
    }
    
    .clawd-quick-start-cta {
      flex-direction: column;
      align-items: center;
    }
    
    .clawd-quick-start-cta .clawd-btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>

<script>
  // Copy to clipboard functionality
  const copyButtons = document.querySelectorAll('.clawd-copy-btn');
  
  copyButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const command = btn.getAttribute('data-command');
      if (command) {
        try {
          await navigator.clipboard.writeText(command);
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 8l4 4 8-8" stroke="var(--cyan-bright)" stroke-width="2" fill="none"/></svg>';
          setTimeout(() => {
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 4v-1.5c0-.828.672-1.5 1.5-1.5h6c.828 0 1.5.672 1.5 1.5v8c0 .828-.672 1.5-1.5 1.5h-1.5m-6-8h-1.5c-.828 0-1.5.672-1.5 1.5v8c0 .828.672 1.5 1.5 1.5h6c.828 0 1.5-.672 1.5-1.5v-1.5" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      }
    });
  });
</script>

