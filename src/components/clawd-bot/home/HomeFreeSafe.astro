---
/**
 * 首页：Is Clawd Bot free? Is it safe?
 * 使用项目 i18n：clawdbot-home-translations
 */
interface Props { locale: string; }
const { locale } = Astro.props;
import { tClawdbotHome, type ClawdbotHomeLocale } from '../../../i18n/clawdbot-home-translations';

const t = (key: string) => tClawdbotHome(locale as ClawdbotHomeLocale, key);
const DOCS_SECURITY = 'https://docs.clawd.bot/security';
---

<section class="home-section home-freesafe" id="free-safe">
  <div class="clawd-container">
    <div class="home-freesafe-grid">
      <div class="clawd-card home-freesafe-card">
        <h2 class="home-section-title home-freesafe-title">{t('home_freesafe_freeTitle')}</h2>
        <p class="home-freesafe-p">{t('home_freesafe_freeBody')}</p>
      </div>
      <div class="clawd-card home-freesafe-card">
        <h2 class="home-section-title home-freesafe-title">{t('home_freesafe_safeTitle')}</h2>
        <p class="home-freesafe-p">{t('home_freesafe_safeBody')}</p>
        <p class="home-freesafe-p home-freesafe-note">{t('home_freesafe_safeNote')}</p>
        <a href={DOCS_SECURITY} target="_blank" rel="noopener noreferrer" class="home-freesafe-link">{t('home_freesafe_docsSecurity')} →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-freesafe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
  }
  .home-freesafe-title { margin-bottom: var(--space-md); }
  .home-freesafe-p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }
  .home-freesafe-link {
    color: var(--coral-bright);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-freesafe-link:hover { text-decoration-thickness: 2px; }
  .home-freesafe-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }
</style>
