---
/**
 * ClawdBot Hero - 简洁现代风格
 */
interface Props { locale: string; }
const { locale } = Astro.props;
import { tClawdbotHome, type ClawdbotHomeLocale } from '../../../i18n/clawdbot-home-translations';

const t = (key: string) => tClawdbotHome(locale as ClawdbotHomeLocale, key);
const DOCS_URL = 'https://docs.clawd.bot';
---

<section class="hero">
  <div class="hero-bg"></div>
  <div class="clawd-container">
    <div class="hero-content">
      <h1 class="hero-title">{t('home_hero_title')}</h1>
      <p class="hero-subtitle">{t('home_hero_subtitle')}</p>
      <p class="hero-description">
        {t('home_hero_description')}
      </p>
      <p class="hero-tagline">
        {t('home_hero_tagline')}
      </p>
      <div class="hero-cta">
        <a href={DOCS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {t('home_hero_ctaDocs')}
        </a>
        <a href="#install" class="btn btn-secondary">{t('home_hero_ctaInstall')}</a>
      </div>
    </div>
    
    <div class="hero-stats">
      <div class="stat-card">
        <div class="stat-value">12+</div>
        <div class="stat-label">{t('home_hero_stat_platforms')}</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">100%</div>
        <div class="stat-label">{t('home_hero_stat_opensource')}</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">MIT</div>
        <div class="stat-label">{t('home_hero_stat_license')}</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">Local</div>
        <div class="stat-label">{t('home_hero_stat_privacy')}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 5rem 0 3rem;
    overflow: hidden;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at top center, rgba(255, 77, 77, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(0, 229, 204, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
  }
  
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  
  .hero-subtitle {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    font-weight: 500;
    color: var(--coral-bright);
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  
  .hero-description {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }
  
  .hero-tagline {
    font-size: 0.95rem;
    color: var(--cyan-bright);
    margin-bottom: 2rem;
    font-weight: 500;
  }
  
  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    min-width: 160px;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, var(--coral-bright), var(--coral-mid));
    color: white;
    box-shadow: 0 0 20px rgba(255, 77, 77, 0.3);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(255, 77, 77, 0.5);
  }
  
  .btn-secondary {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }
  
  .btn-secondary:hover {
    border-color: var(--coral-bright);
    background: rgba(255, 77, 77, 0.1);
  }
  
  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .stat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.5rem 1rem;
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .stat-card:hover {
    border-color: var(--coral-bright);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(255, 77, 77, 0.2);
  }
  
  .stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--coral-bright);
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 2rem;
    }
    
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    
    .hero-cta {
      flex-direction: column;
      align-items: center;
    }
    
    .btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
