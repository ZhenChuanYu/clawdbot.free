---
/**
 * ClawdBot 核心特性展示 - 多语言
 */
interface Props { locale: string; }
const { locale } = Astro.props;
import { tClawdbotHome, type ClawdbotHomeLocale } from '../../../i18n/clawdbot-home-translations';
const t = (key: string) => tClawdbotHome(locale as ClawdbotHomeLocale, key);
---

<section class="features" id="features">
  <div class="clawd-container">
    <h2 class="section-title">{t('home_features_title')}</h2>
    <p class="section-subtitle">{t('home_features_subtitle')}</p>
    
    <div class="features-grid">
      <div class="feature-card highlight">
        <div class="feature-icon">🎙️</div>
        <h3 class="feature-title">{t('home_f1_title')}</h3>
        <p class="feature-desc">{t('home_f1_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f1_stat')}</span>
          <span class="stat-text">{t('home_f1_stattext')}</span>
        </div>
      </div>
      <div class="feature-card highlight">
        <div class="feature-icon">🎨</div>
        <h3 class="feature-title">{t('home_f2_title')}</h3>
        <p class="feature-desc">{t('home_f2_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f2_stat')}</span>
          <span class="stat-text">{t('home_f2_stattext')}</span>
        </div>
      </div>
      <div class="feature-card highlight">
        <div class="feature-icon">📦</div>
        <h3 class="feature-title">{t('home_f3_title')}</h3>
        <p class="feature-desc">{t('home_f3_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f3_stat')}</span>
          <span class="stat-text">{t('home_f3_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💬</div>
        <h3 class="feature-title">{t('home_f4_title')}</h3>
        <p class="feature-desc">{t('home_f4_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f4_stat')}</span>
          <span class="stat-text">{t('home_f4_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌐</div>
        <h3 class="feature-title">{t('home_f5_title')}</h3>
        <p class="feature-desc">{t('home_f5_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f5_stat')}</span>
          <span class="stat-text">{t('home_f5_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3 class="feature-title">{t('home_f6_title')}</h3>
        <p class="feature-desc">{t('home_f6_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f6_stat')}</span>
          <span class="stat-text">{t('home_f6_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3 class="feature-title">{t('home_f7_title')}</h3>
        <p class="feature-desc">{t('home_f7_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f7_stat')}</span>
          <span class="stat-text">{t('home_f7_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💻</div>
        <h3 class="feature-title">{t('home_f8_title')}</h3>
        <p class="feature-desc">{t('home_f8_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f8_stat')}</span>
          <span class="stat-text">{t('home_f8_stattext')}</span>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🧠</div>
        <h3 class="feature-title">{t('home_f9_title')}</h3>
        <p class="feature-desc">{t('home_f9_desc')}</p>
        <div class="feature-stat">
          <span class="stat-number">{t('home_f9_stat')}</span>
          <span class="stat-text">{t('home_f9_stattext')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding: 4rem 0;
    background: var(--bg-surface);
  }
  
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 1rem;
  }
  
  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .feature-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    transition: all 0.3s ease;
  }
  
  .feature-card:hover {
    border-color: var(--coral-bright);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(255, 77, 77, 0.2);
  }
  
  .feature-card.highlight {
    border-color: var(--coral-bright);
    background: linear-gradient(135deg, rgba(255, 77, 77, 0.05), rgba(0, 229, 204, 0.05));
  }
  
  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .feature-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  
  .feature-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  
  .feature-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  
  .stat-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--coral-bright);
  }
  
  .stat-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .features {
      padding: 3rem 0;
    }
    
    .features-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
