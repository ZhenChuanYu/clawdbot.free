---

<section class="clawd-features" id="features">
  <div class="clawd-container">
    <!-- Section Header -->
    <div class="clawd-section-header">
      <span class="clawd-section-prefix">{t.sectionPrefix}</span>
      <h2 class="clawd-heading-2">{t.sectionTitle}</h2>
    </div>
    <p class="clawd-section-subtitle">{t.subtitle}</p>
    
    <!-- Features Grid -->
    <div class="clawd-features-grid">
      {t.features.map((feature, index) => (
        <div class="clawd-feature-card" style={`animation-delay: ${index * 0.1}s`}>
          <div class="clawd-feature-icon">{feature.icon}</div>
          <h3 class="clawd-feature-title">{feature.title}</h3>
          <p class="clawd-feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clawd-features {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-surface) 100%);
  }
  
  .clawd-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  
  .clawd-section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 3rem;
  }
  
  .clawd-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  .clawd-feature-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 2rem;
    transition: all var(--transition-normal);
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .clawd-feature-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(255, 77, 77, 0.1);
  }
  
  .clawd-feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .clawd-feature-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .clawd-feature-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  
  @media (max-width: 1024px) {
    .clawd-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .clawd-features {
      padding: 4rem 0;
    }
    
    .clawd-features-grid {
      grid-template-columns: 1fr;
    }
    
    .clawd-feature-card {
      padding: 1.5rem;
    }
  }
</style>

