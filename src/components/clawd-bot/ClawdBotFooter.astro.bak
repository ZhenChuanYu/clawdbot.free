};

const t = content[locale as keyof typeof content] || content.en;
---

<footer class="clawd-footer">
  <div class="clawd-container">
    <div class="clawd-footer-grid">
      <!-- Brand Column -->
      <div class="clawd-footer-brand">
        <a href="/" class="clawd-footer-logo" title="ClawdBot Home">
          <span class="clawd-footer-logo-icon">🦞</span>
          <span class="clawd-footer-logo-text">{t.brand}</span>
        </a>
        <p class="clawd-footer-tagline">{t.tagline}</p>
        
        <!-- Social Links -->
        <div class="clawd-footer-social">
          <a href="https://docs.clawd.bot" target="_blank" rel="noopener noreferrer" title="Documentation" class="clawd-social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </a>
          <a href="https://github.com/openclaw" target="_blank" rel="noopener noreferrer" title="GitHub" class="clawd-social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Link Columns -->
      <div class="clawd-footer-links">
        <span class="clawd-footer-links-title">{t.links.product.title}</span>
        <ul>
          {t.links.product.items.map(item => (
            <li>
              <a href={item.href} title={item.label}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="clawd-footer-links">
        <span class="clawd-footer-links-title">{t.links.resources.title}</span>
        <ul>
          {t.links.resources.items.map(item => (
            <li>
              <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} title={item.label}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="clawd-footer-links">
        <span class="clawd-footer-links-title">{t.links.community.title}</span>
        <ul>
          {t.links.community.items.map(item => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer" title={item.label}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="clawd-footer-bottom">
      <p class="clawd-footer-copyright">{t.copyright}</p>
      <div class="clawd-footer-legal">
        {t.legal.map((item, index) => (
          <>
            <a href={item.href} title={item.label}>{item.label}</a>
            {index < t.legal.length - 1 && <span class="clawd-footer-legal-divider">·</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .clawd-footer {
    padding: 4rem 0 2rem;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }
  
  .clawd-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  
  .clawd-footer-brand {
    max-width: 280px;
  }
  
  .clawd-footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }
  
  .clawd-footer-logo-icon {
    font-size: 1.5rem;
  }
  
  .clawd-footer-tagline {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .clawd-footer-social {
    display: flex;
    gap: 1rem;
  }
  
  .clawd-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }
  
  .clawd-social-link:hover {
    border-color: var(--coral-bright);
    color: var(--coral-bright);
  }
  
  .clawd-footer-links-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
  }
  
  .clawd-footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .clawd-footer-links li {
    margin-bottom: 0.5rem;
  }
  
  .clawd-footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }
  
  .clawd-footer-links a:hover {
    color: var(--coral-bright);
  }
  
  .clawd-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  
  .clawd-footer-copyright {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  
  .clawd-footer-legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .clawd-footer-legal a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color var(--transition-fast);
  }
  
  .clawd-footer-legal a:hover {
    color: var(--text-primary);
  }
  
  .clawd-footer-legal-divider {
    color: var(--text-secondary);
  }
  
  @media (max-width: 1024px) {
    .clawd-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    
    .clawd-footer-brand {
      grid-column: span 2;
      max-width: none;
    }
  }
  
  @media (max-width: 640px) {
    .clawd-footer {
      padding: 3rem 0 1.5rem;
    }
    
    .clawd-footer-grid {
