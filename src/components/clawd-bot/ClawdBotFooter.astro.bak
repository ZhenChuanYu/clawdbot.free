---
/**
 * ClawdBot 页脚组件
 */
interface Props {
  locale: string;
}

const { locale } = Astro.props;

const content = {
  en: {
    brand: 'ClawdBot',
    tagline: 'The AI that actually does things.',
    links: {
      product: {
        title: 'Product',
        items: [
          { label: 'Features', href: '#features' },
          { label: 'Install', href: '#install' },
          { label: 'About', href: '#about' }
        ]
      },
      resources: {
        title: 'Resources',
        items: [
          { label: 'Documentation', href: 'https://docs.clawd.bot' },
          { label: 'API Reference', href: 'https://docs.clawd.bot/api' },
          { label: 'Skills', href: 'https://clawd.bot/skills' },
          { label: 'Blog', href: 'https://clawd.bot/blog' }
        ]
      },
      community: {
        title: 'Community',
        items: [
          { label: 'GitHub', href: 'https://github.com/openclaw' },
          { label: 'Discord', href: 'https://discord.gg/clawdbot' },
          { label: 'Clawdbot', href: 'https://clawdbot.free' },
        ]
      }
    },
    copyright: '© 2026 ClawdBot. All rights reserved.',
    legal: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' }
    ]
  },
  zh: {
    brand: 'ClawdBot',
    tagline: '真正能做事的 AI。',
