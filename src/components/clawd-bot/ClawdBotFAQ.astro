const t = content[locale as keyof typeof content] || content.en;
---

<section class="clawd-faq" id="faq">
  <div class="clawd-container">
    <!-- Section Header -->
    <div class="clawd-section-header">
      <span class="clawd-section-prefix">{t.sectionPrefix}</span>
      <h2 class="clawd-heading-2">{t.sectionTitle}</h2>
    </div>
    <p class="clawd-section-subtitle">{t.subtitle}</p>
    
    <!-- FAQ Items -->
    <div class="clawd-faq-list">
      {t.faqs.map((faq, index) => (
        <details class="clawd-faq-item" style={`animation-delay: ${index * 0.05}s`}>
          <summary class="clawd-faq-question">
            <span>{faq.question}</span>
            <svg class="clawd-faq-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="clawd-faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .clawd-faq {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-surface) 100%);
  }
  
  .clawd-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  
  .clawd-section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 3rem;
  }
  
  .clawd-faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .clawd-faq-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .clawd-faq-item[open] {
    border-color: var(--border-accent);
  }
  
  .clawd-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }
  
  .clawd-faq-question::-webkit-details-marker {
    display: none;
  }
  
  .clawd-faq-question:hover {
    color: var(--coral-bright);
  }
  
  .clawd-faq-icon {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--transition-normal);
  }
  
  .clawd-faq-item[open] .clawd-faq-icon {
    transform: rotate(180deg);
    color: var(--coral-bright);
  }
  
  .clawd-faq-answer {
    padding: 0 1.5rem 1.25rem;
  }
  
  .clawd-faq-answer p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  
  @media (max-width: 640px) {
    .clawd-faq {
      padding: 4rem 0;
    }
    
    .clawd-faq-question {
      padding: 1rem 1.25rem;
      font-size: 0.9375rem;
    }
    
    .clawd-faq-answer {
      padding: 0 1.25rem 1rem;
    }
  }
</style>

