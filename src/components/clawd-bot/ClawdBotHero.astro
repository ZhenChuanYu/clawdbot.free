---
/**
 * Clawd Bot Hero 区域组件
 */
interface Props {
  locale: string;
}

const { locale } = Astro.props;

// 多语言内容
const content = {
  en: {
    badge: 'Open Source Personal AI',
    title: 'Clawd Bot',
    subtitle: 'THE AI THAT ACTUALLY DOES THINGS.',
    description: 'Clawd Bot is your personal AI assistant that runs on your machine. Clawd Bot clears your inbox, sends emails, manages your calendar, checks you in for flights. With Clawd Bot, all from WhatsApp, Telegram, or any chat app you already use. Experience the power of Clawd Bot today.',
    ctaPrimary: 'Get Started with Clawd Bot',
    ctaSecondary: 'View Clawd Bot Documentation',
  },
  zh: {
    badge: '开源个人 AI',
    title: 'Clawd Bot',
    subtitle: '真正能做事的 AI 助手',
    description: 'Clawd Bot 是运行在您本地机器上的个人 AI 助手。Clawd Bot 可以清理收件箱、发送邮件、管理日历、航班值机。通过 WhatsApp、Telegram 或任何您常用的聊天应用即可控制 Clawd Bot。立即体验 Clawd Bot 的强大功能。',
    ctaPrimary: '立即开始使用 Clawd Bot',
    ctaSecondary: '查看 Clawd Bot 文档',
  },
  ja: {
    badge: 'オープンソース パーソナルAI',
    title: 'Clawd Bot',
    subtitle: '実際に仕事をするAI',
    description: 'あなたのマシン上で動作するパーソナルAIアシスタント。受信トレイの整理、メール送信、カレンダー管理、フライトチェックイン。WhatsApp、Telegram、普段使っているチャットアプリから操作可能。',
    ctaPrimary: '始める',
    ctaSecondary: 'ドキュメント',
  },
  ko: {
    badge: '오픈소스 개인 AI',
    title: 'Clawd Bot',
    subtitle: '실제로 일을 하는 AI',
    description: '당신의 컴퓨터에서 실행되는 개인 AI 어시스턴트. 받은편지함 정리, 이메일 전송, 캘린더 관리, 항공편 체크인. WhatsApp, Telegram 등 평소 사용하는 채팅 앱에서 제어하세요.',
    ctaPrimary: '시작하기',
    ctaSecondary: '문서 보기',
  },
  es: {
    badge: 'IA Personal de Código Abierto',
    title: 'Clawd Bot',
    subtitle: 'LA IA QUE REALMENTE HACE COSAS',
    description: 'Tu asistente de IA personal que se ejecuta en tu máquina. Limpia tu bandeja de entrada, envía correos, gestiona tu calendario, hace check-in en vuelos. Todo desde WhatsApp, Telegram o cualquier app de chat que ya uses.',
    ctaPrimary: 'Comenzar',
    ctaSecondary: 'Ver Documentación',
  },
  de: {
    badge: 'Open Source Persönliche KI',
    title: 'Clawd Bot',
    subtitle: 'DIE KI, DIE WIRKLICH DINGE TUT',
    description: 'Ihr persönlicher KI-Assistent, der auf Ihrem Computer läuft. Räumt Ihren Posteingang auf, sendet E-Mails, verwaltet Ihren Kalender, checkt Sie für Flüge ein. Alles über WhatsApp, Telegram oder jede Chat-App, die Sie bereits nutzen.',
    ctaPrimary: 'Loslegen',
    ctaSecondary: 'Dokumentation',
  },
  fr: {
    badge: 'IA Personnelle Open Source',
    title: 'Clawd Bot',
    subtitle: "L'IA QUI FAIT VRAIMENT DES CHOSES",
    description: 'Votre assistant IA personnel qui fonctionne sur votre machine. Nettoie votre boîte de réception, envoie des emails, gère votre calendrier, effectue votre enregistrement de vol. Le tout depuis WhatsApp, Telegram ou toute application de chat que vous utilisez déjà.',
    ctaPrimary: 'Commencer',
    ctaSecondary: 'Documentation',
  },
  pt: {
    badge: 'IA Pessoal Open Source',
    title: 'Clawd Bot',
    subtitle: 'A IA QUE REALMENTE FAZ COISAS',
    description: 'Seu assistente de IA pessoal que roda na sua máquina. Limpa sua caixa de entrada, envia emails, gerencia seu calendário, faz check-in em voos. Tudo pelo WhatsApp, Telegram ou qualquer app de chat que você já usa.',
    ctaPrimary: 'Começar',
    ctaSecondary: 'Ver Documentação',
  },
  ru: {
    badge: 'Персональный ИИ с открытым кодом',
    title: 'Clawd Bot',
    subtitle: 'ИИ, КОТОРЫЙ ДЕЙСТВИТЕЛЬНО ДЕЛАЕТ ВЕЩИ',
    description: 'Ваш персональный ИИ-ассистент, работающий на вашем компьютере. Очищает почту, отправляет письма, управляет календарём, регистрирует на рейсы. Всё через WhatsApp, Telegram или любой другой мессенджер.',
    ctaPrimary: 'Начать',
    ctaSecondary: 'Документация',
  },
};

const t = content[locale as keyof typeof content] || content.en;
---

<section class="clawd-hero" id="hero">
  <div class="clawd-hero-bg"></div>
  <div class="clawd-container">
    <div class="clawd-hero-content">
      <!-- Badge -->
      <div class="clawd-hero-badge">
        <span class="clawd-hero-badge-icon">⚡</span>
        <span>{t.badge}</span>
      </div>
      
      <!-- Logo Icon -->
      <div class="clawd-hero-logo">
        <span class="clawd-hero-lobster">🦞</span>
      </div>
      
      <!-- Title -->
      <h1 class="clawd-hero-title">{t.title}</h1>
      
      <!-- Subtitle -->
      <p class="clawd-hero-subtitle">{t.subtitle}</p>
      
      <!-- Description -->
      <p class="clawd-hero-description">{t.description}</p>
      
      <!-- CTA Buttons -->
      <div class="clawd-hero-cta">
        <a href="#quick-start" class="clawd-btn clawd-btn-primary" title="Get started with Clawd Bot - Download Clawd Bot">
          {t.ctaPrimary}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 1l7 7-7 7M1 8h14" stroke="currentColor" stroke-width="2" fill="none"/>
          </svg>
        </a>
        <a href="https://docs.clawd.bot" target="_blank" rel="noopener noreferrer" class="clawd-btn clawd-btn-secondary" title="Read Clawd Bot documentation - Clawd Bot guide">
          {t.ctaSecondary}
        </a>
      </div>
      
      <!-- Stats -->
      <div class="clawd-hero-stats">
        <div class="clawd-hero-stat">
          <span class="clawd-hero-stat-value">50+</span>
          <span class="clawd-hero-stat-label">Integrations</span>
        </div>
        <div class="clawd-hero-stat-divider"></div>
        <div class="clawd-hero-stat">
          <span class="clawd-hero-stat-value">10K+</span>
          <span class="clawd-hero-stat-label">Users</span>
        </div>
        <div class="clawd-hero-stat-divider"></div>
        <div class="clawd-hero-stat">
          <span class="clawd-hero-stat-value">100%</span>
          <span class="clawd-hero-stat-label">Open Source</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .clawd-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
    overflow: hidden;
  }
  
  .clawd-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at top center, rgba(255, 77, 77, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at bottom right, rgba(0, 229, 204, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .clawd-hero-content {
    position: relative;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .clawd-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-full);
    color: var(--coral-bright);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  
  .clawd-hero-badge-icon {
    font-size: 1rem;
  }
  
  .clawd-hero-logo {
    margin-bottom: 1.5rem;
  }
  
  .clawd-hero-lobster {
    font-size: 5rem;
    display: block;
    animation: float 3s ease-in-out infinite;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .clawd-hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  
  .clawd-hero-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 500;
    color: var(--coral-bright);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }
  
  .clawd-hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .clawd-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }
  
  .clawd-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  
  .clawd-hero-stat {
    text-align: center;
  }
  
  .clawd-hero-stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  
  .clawd-hero-stat-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  
  .clawd-hero-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }
  
  @media (max-width: 640px) {
    .clawd-hero {
      padding: 5rem 0 3rem;
    }
    
    .clawd-hero-stats {
      flex-direction: column;
      gap: 1rem;
    }
    
    .clawd-hero-stat-divider {
      width: 40px;
      height: 1px;
    }
    
    .clawd-hero-cta {
      flex-direction: column;
      align-items: center;
    }
    
    .clawd-hero-cta .clawd-btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>

