const t = content[locale as keyof typeof content] || content.en;
---

<section class="clawd-use-cases" id="use-cases">
  <div class="clawd-container">
    <!-- Section Header -->
    <div class="clawd-section-header">
      <span class="clawd-section-prefix">{t.sectionPrefix}</span>
      <h2 class="clawd-heading-2">{t.sectionTitle}</h2>
    </div>
    <p class="clawd-section-subtitle">{t.subtitle}</p>
    
    <!-- Use Cases Grid -->
    <div class="clawd-use-cases-grid">
      {t.useCases.map((useCase, index) => (
        <div class="clawd-use-case-card" style={`animation-delay: ${index * 0.1}s`}>
          <h3 class="clawd-use-case-title">{useCase.title}</h3>
          <p class="clawd-use-case-description">{useCase.description}</p>
          <div class="clawd-use-case-command">
            <code>{useCase.command}</code>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clawd-use-cases {
    padding: 6rem 0;
    background: var(--bg-deep);
  }
  
  .clawd-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  
  .clawd-section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 3rem;
  }
  
  .clawd-use-cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  .clawd-use-case-card {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-elevated) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    transition: all var(--transition-normal);
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .clawd-use-case-card:hover {
    border-color: var(--border-cyan);
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0, 229, 204, 0.1);
  }
  
  .clawd-use-case-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .clawd-use-case-description {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .clawd-use-case-command {
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem;
  }
  
  .clawd-use-case-command code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--cyan-bright);
  }
  
  @media (max-width: 1024px) {
    .clawd-use-cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .clawd-use-cases {
      padding: 4rem 0;
    }
    
    .clawd-use-cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

