---
import { t, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stats = [
  { value: '1483', labelKey: 'grok_stats_lmArenaElo' },
  { value: '1722', labelKey: 'grok_stats_creativeWriting' },
  { value: '4.22%', labelKey: 'grok_stats_hallucinationRate' },
  { value: 'Top 1', labelKey: 'grok_stats_reasoning' },
];

const infoCards = [
  { 
    iconPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    titleKey: 'grok_info_reasoning_title',
    descKey: 'grok_info_reasoning_desc',
    gradient: 'from-blue-500 to-cyan-500'
  },
  {
    iconPath: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    titleKey: 'grok_info_creative_title',
    descKey: 'grok_info_creative_desc',
    gradient: 'from-purple-500 to-pink-500'
  },
  {
    iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    titleKey: 'grok_info_accuracy_title',
    descKey: 'grok_info_accuracy_desc',
    gradient: 'from-green-500 to-emerald-500'
  },
  {
    iconPath: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
    titleKey: 'grok_info_emotional_title',
    descKey: 'grok_info_emotional_desc',
    gradient: 'from-pink-500 to-rose-500'
  },
  {
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
    titleKey: 'grok_info_realtime_title',
    descKey: 'grok_info_realtime_desc',
    gradient: 'from-orange-500 to-yellow-500'
  },
  {
    iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    titleKey: 'grok_info_developer_title',
    descKey: 'grok_info_developer_desc',
    gradient: 'from-cyan-500 to-blue-500'
  },
];

const performanceMetrics = {
  reasoning: [
    { labelKey: 'grok_performance_reasoning_lmArena_label', value: '1483', descKey: 'grok_performance_reasoning_lmArena_desc' },
    { labelKey: 'grok_performance_reasoning_creative_label', value: '1722', descKey: 'grok_performance_reasoning_creative_desc' },
    { labelKey: 'grok_performance_reasoning_hallucination_label', value: '4.22%', descKey: 'grok_performance_reasoning_hallucination_desc' },
    { labelKey: 'grok_performance_reasoning_reasoning_label', value: 'Top 1', descKey: 'grok_performance_reasoning_reasoning_desc' },
  ],
  coding: [
    { labelKey: 'grok_performance_coding_benchmark_label', value: '76.2%', descKey: 'grok_performance_coding_benchmark_desc' },
    { labelKey: 'grok_performance_coding_improvement_label', value: '+35%', descKey: 'grok_performance_coding_improvement_desc' },
  ],
  multimodal: [
    { labelKey: 'grok_performance_multimodal_understanding_label', value: '81%', descKey: 'grok_performance_multimodal_understanding_desc' },
    { labelKey: 'grok_performance_multimodal_context_label', value: '131k', descKey: 'grok_performance_multimodal_context_desc' },
  ],
  safety: [
    { labelKey: 'grok_performance_safety_framework_label', value: '✓', descKey: 'grok_performance_safety_framework_desc' },
    { labelKey: 'grok_performance_safety_reduction_label', value: '-30%', descKey: 'grok_performance_safety_reduction_desc' },
  ],
};

const features = [
  { iconPath: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', titleKey: 'grok_features_emotionalIntelligence_title', descKey: 'grok_features_emotionalIntelligence_description', gradient: 'from-pink-500 to-rose-500' },
  { iconPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z', titleKey: 'grok_features_reasoning_title', descKey: 'grok_features_reasoning_description', gradient: 'from-blue-500 to-cyan-500' },
  { iconPath: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z', titleKey: 'grok_features_creativeWriting_title', descKey: 'grok_features_creativeWriting_description', gradient: 'from-purple-500 to-pink-500' },
  { iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', titleKey: 'grok_features_factualAccuracy_title', descKey: 'grok_features_factualAccuracy_description', gradient: 'from-green-500 to-emerald-500' },
  { iconPath: 'M13 10V3L4 14h7v7l9-11h-7z', titleKey: 'grok_features_realTimeData_title', descKey: 'grok_features_realTimeData_description', gradient: 'from-orange-500 to-yellow-500' },
  { iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4', titleKey: 'grok_features_developerFriendly_title', descKey: 'grok_features_developerFriendly_description', gradient: 'from-cyan-500 to-blue-500' },
];

const platforms = [
  { titleKey: 'grok_platforms_xai_title', descKey: 'grok_platforms_xai_description', link: 'https://console.x.ai', linkKey: 'grok_platforms_xai_link', gradient: 'from-gray-900 to-gray-800' },
  { titleKey: 'grok_platforms_azure_title', descKey: 'grok_platforms_azure_description', link: 'https://azure.microsoft.com/', linkKey: 'grok_platforms_azure_link', gradient: 'from-blue-600 to-blue-700' },
  { titleKey: 'grok_platforms_github_title', descKey: 'grok_platforms_github_description', link: 'https://github.com/models', linkKey: 'grok_platforms_github_link', gradient: 'from-gray-800 to-gray-900' },
  { titleKey: 'grok_platforms_oracle_title', descKey: 'grok_platforms_oracle_description', link: 'https://www.oracle.com/cloud/', linkKey: 'grok_platforms_oracle_link', gradient: 'from-red-600 to-red-700' },
  { titleKey: 'grok_platforms_aws_title', descKey: 'grok_platforms_aws_description', link: 'https://aws.amazon.com/bedrock/', linkKey: 'grok_platforms_aws_link', gradient: 'from-orange-500 to-orange-600' },
];

const faqItems = [
  { qKey: 'grok_faq_questions_what_question', aKey: 'grok_faq_questions_what_answer' },
  { qKey: 'grok_faq_questions_difference_question', aKey: 'grok_faq_questions_difference_answer' },
  { qKey: 'grok_faq_questions_useCases_question', aKey: 'grok_faq_questions_useCases_answer' },
  { qKey: 'grok_faq_questions_apiKey_question', aKey: 'grok_faq_questions_apiKey_answer' },
  { qKey: 'grok_faq_questions_support_question', aKey: 'grok_faq_questions_support_answer' },
];
---

<div class="relative">
  <!-- Hero Section - Enhanced -->
  <section class="relative overflow-hidden bg-gradient-to-b from-white via-gray-50 to-white">
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-12 pb-16 md:pb-32">
      <!-- Release Date Banner -->
      <div class="text-center mb-8">
        <p class="text-sm text-gray-600 font-medium">
          {t(locale, 'grok_releasedDate')}: November 18, 2024
        </p>
      </div>

      <div class="text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-900 text-white text-xs font-medium rounded-full mb-8">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
          </svg>
          <span>{t(locale, 'grok_badge')}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-6xl md:text-8xl font-bold text-gray-900 mb-6 tracking-tight leading-none">
          {t(locale, 'grok_title')}
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-600 mb-4 font-light max-w-3xl mx-auto">
          {t(locale, 'grok_subtitle')}
        </p>

        <p class="text-base md:text-lg text-gray-500 mb-8 font-light max-w-2xl mx-auto leading-relaxed">
          {t(locale, 'grok_description')}
        </p>

        <!-- Disclaimer -->
        <p class="text-sm text-gray-600 mb-12 font-normal max-w-2xl mx-auto leading-relaxed">
          {t(locale, 'grok_disclaimer')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
          <a
            href="https://console.x.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-8 py-4 bg-gray-900 text-white text-base font-medium rounded-lg hover:bg-gray-800 transition-all shadow-lg hover:shadow-xl"
          >
            {t(locale, 'common_getStarted')}
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#capabilities"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-gray-900 text-base font-medium rounded-lg border border-gray-200 hover:border-gray-300 transition-all shadow-sm hover:shadow-md"
          >
            {t(locale, 'grok_viewCapabilities')}
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl mx-auto">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-3xl font-bold text-gray-900 mb-2">{stat.value}</div>
              <div class="text-sm text-gray-600 font-light">{t(locale, stat.labelKey)}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Grok API Information and Resources Section (New - Inspired by gemini3.us) -->
  <section id="capabilities" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-600 mb-3 uppercase tracking-wide">
          {t(locale, 'grok_info_smallTitle')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {t(locale, 'grok_info_mainTitle')}
        </h2>
        <p class="text-lg text-gray-600 font-light">
          {t(locale, 'grok_info_subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {infoCards.map((card) => (
          <div class="group p-8 bg-gray-50 rounded-2xl hover:shadow-xl transition-all duration-300">
            <div class={`inline-flex p-3 bg-gradient-to-br ${card.gradient} rounded-xl mb-4 text-white`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.iconPath}></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {t(locale, card.titleKey)}
            </h3>
            <p class="text-gray-600 font-light leading-relaxed">
              {t(locale, card.descKey)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Performance Section (New - Inspired by gemini3.us) -->
  <section id="performance" class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-600 mb-3 uppercase tracking-wide">
          {t(locale, 'grok_performance_smallTitle')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {t(locale, 'grok_performance_mainTitle')}
        </h2>
        <p class="text-lg text-gray-600 font-light">
          {t(locale, 'grok_performance_subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Reasoning Performance -->
        <div class="p-8 bg-white border border-gray-200 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="inline-flex p-2 bg-blue-100 rounded-lg">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900">{t(locale, 'grok_performance_reasoning_title')}</h3>
          </div>
          <div class="space-y-4">
            {performanceMetrics.reasoning.map((metric) => (
              <div class="flex items-start justify-between gap-4 pb-4 border-b border-gray-100 last:border-0 last:pb-0">
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{t(locale, metric.labelKey)}</div>
                  <div class="text-xs text-gray-600 mt-0.5">{t(locale, metric.descKey)}</div>
                </div>
                <div class="text-lg font-bold text-gray-900">{metric.value}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Coding Performance -->
        <div class="p-8 bg-white border border-gray-200 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="inline-flex p-2 bg-purple-100 rounded-lg">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900">{t(locale, 'grok_performance_coding_title')}</h3>
          </div>
          <div class="space-y-4">
            {performanceMetrics.coding.map((metric) => (
              <div class="flex items-start justify-between gap-4 pb-4 border-b border-gray-100 last:border-0 last:pb-0">
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{t(locale, metric.labelKey)}</div>
                  <div class="text-xs text-gray-600 mt-0.5">{t(locale, metric.descKey)}</div>
                </div>
                <div class="text-lg font-bold text-gray-900">{metric.value}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Multimodal Performance -->
        <div class="p-8 bg-white border border-gray-200 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="inline-flex p-2 bg-green-100 rounded-lg">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900">{t(locale, 'grok_performance_multimodal_title')}</h3>
          </div>
          <div class="space-y-4">
            {performanceMetrics.multimodal.map((metric) => (
              <div class="flex items-start justify-between gap-4 pb-4 border-b border-gray-100 last:border-0 last:pb-0">
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{t(locale, metric.labelKey)}</div>
                  <div class="text-xs text-gray-600 mt-0.5">{t(locale, metric.descKey)}</div>
                </div>
                <div class="text-lg font-bold text-gray-900">{metric.value}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Safety Performance -->
        <div class="p-8 bg-white border border-gray-200 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="inline-flex p-2 bg-emerald-100 rounded-lg">
              <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900">{t(locale, 'grok_performance_safety_title')}</h3>
          </div>
          <div class="space-y-4">
            {performanceMetrics.safety.map((metric) => (
              <div class="flex items-start justify-between gap-4 pb-4 border-b border-gray-100 last:border-0 last:pb-0">
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{t(locale, metric.labelKey)}</div>
                  <div class="text-xs text-gray-600 mt-0.5">{t(locale, metric.descKey)}</div>
                </div>
                <div class="text-lg font-bold text-gray-900">{metric.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is Grok API Section -->
  <section id="what-is" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-600 mb-3 uppercase tracking-wide">
          {t(locale, 'grok_whatIs_smallTitle')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {t(locale, 'grok_whatIs_mainTitle')}
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">
          {t(locale, 'grok_whatIs_description')}
        </p>

        <div class="bg-gray-50 rounded-2xl p-8 mb-8">
          <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            {t(locale, 'grok_whatIs_keyPoints')}
          </h3>
          <ul class="space-y-4">
            {[1, 2, 3, 4, 5].map((i) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t(locale, `grok_whatIs_keyPoint${i}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="text-sm font-semibold text-blue-600 mb-3 uppercase tracking-wide">
          {t(locale, 'grok_whyChoose_smallTitle')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {t(locale, 'grok_whyChoose_mainTitle')}
        </h2>
        <p class="text-lg text-gray-600 font-light">
          {t(locale, 'grok_whyChoose_subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="group p-8 bg-gray-50 rounded-2xl hover:shadow-xl transition-all duration-300">
            <div class={`inline-flex p-3 bg-gradient-to-br ${feature.gradient} rounded-xl mb-4 text-white`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.iconPath}></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {t(locale, feature.titleKey)}
            </h3>
            <p class="text-gray-600 font-light leading-relaxed">
              {t(locale, feature.descKey)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platforms Section -->
