---
/**
 * Clawd Bot 专用布局组件
 * 深色主题 + 品牌风格
 */

interface Props {
  title: string;
  description: string;
  keywords?: string;
  locale?: string;
  path?: string;
}

const { 
  title, 
  description, 
  keywords = 'Clawd Bot, Clawd Bot AI, Clawd Bot assistant, Clawd Bot personal AI, Clawd Bot WhatsApp, Clawd Bot Telegram, Clawd Bot automation, Clawd Bot open source, Clawd Bot download, Clawd Bot features, Clawd Bot use cases, Clawd Bot integrations, Clawd Bot setup, Clawd Bot tutorial, Clawd Bot guide',
  locale = 'en',
  path = ''
} = Astro.props;

const BASE_URL = 'https://clawd-bot.com';

// 多语言路径处理
function getHreflangPath(pagePath: string, lang: string): string {
  if (lang === 'en') {
    return pagePath || '/';
  }
  return `/${lang}${pagePath ? `/${pagePath}` : ''}`;
}

// 生成 canonical URL - 考虑语言路径
// 如果 path 为空，根据 locale 生成正确的首页 URL
const canonicalUrl = path 
  ? `${BASE_URL}/${path.replace(/^\//, '')}` 
  : `${BASE_URL}${getHreflangPath('', locale)}`;
---

<!DOCTYPE html>
<html lang={locale === 'zh-tw' ? 'zh-TW' : (locale === 'zh' ? 'zh-CN' : locale)}>
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Clawd Bot">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050810">
  
  <!-- DNS Prefetch and Preconnect for external resources -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://api.fontshare.com">
  <link rel="dns-prefetch" href="https://www.clarity.ms">
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Preconnect to Fontshare -->
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  
  <!-- Load fonts with font-display: swap for better performance -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
  
  <!-- Load Fontshare fonts -->
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap">
  
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Clawd Bot">
  <meta name="robots" content="index, follow">
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${BASE_URL}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={locale.replace('-', '_')}>
  <meta property="og:site_name" content="Clawd Bot">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${BASE_URL}/og-image.png`}>
  
  <!-- Hreflang tags -->
  <link rel="alternate" hreflang="en" href={`${BASE_URL}${getHreflangPath(path, 'en')}`}>
  <link rel="alternate" hreflang="zh-CN" href={`${BASE_URL}${getHreflangPath(path, 'zh')}`}>
  <link rel="alternate" hreflang="zh-TW" href={`${BASE_URL}${getHreflangPath(path, 'zh-tw')}`}>
  <link rel="alternate" hreflang="ja" href={`${BASE_URL}${getHreflangPath(path, 'ja')}`}>
  <link rel="alternate" hreflang="ko" href={`${BASE_URL}${getHreflangPath(path, 'ko')}`}>
  <link rel="alternate" hreflang="es" href={`${BASE_URL}${getHreflangPath(path, 'es')}`}>
  <link rel="alternate" hreflang="de" href={`${BASE_URL}${getHreflangPath(path, 'de')}`}>
  <link rel="alternate" hreflang="fr" href={`${BASE_URL}${getHreflangPath(path, 'fr')}`}>
  <link rel="alternate" hreflang="pt" href={`${BASE_URL}${getHreflangPath(path, 'pt')}`}>
  <link rel="alternate" hreflang="ru" href={`${BASE_URL}${getHreflangPath(path, 'ru')}`}>
  <link rel="alternate" hreflang="hi" href={`${BASE_URL}${getHreflangPath(path, 'hi')}`}>
  <link rel="alternate" hreflang="x-default" href={BASE_URL}>
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@id": `${BASE_URL}/#website`,
        "@type": "WebSite",
        "inLanguage": locale === 'zh-tw' ? 'zh-TW' : (locale === 'zh' ? 'zh-CN' : 'en-US'),
        "name": "Clawd Bot",
        "url": BASE_URL,
        "description": "Personal AI assistant that runs on your machine. Control it via WhatsApp, Telegram, Discord and more.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${BASE_URL}/?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@id": `${canonicalUrl}#webpage`,
        "@type": "WebPage",
        "name": title,
        "url": canonicalUrl,
        "description": description,
        "isPartOf": {
          "@id": `${BASE_URL}/#website`
        },
        "about": {
          "@type": "SoftwareApplication",
          "name": "Clawd Bot",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "macOS, Windows, Linux",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      },
      {
        "@type": "Organization",
        "@id": `${BASE_URL}/#organization`,
        "name": "Clawd Bot",
        "url": BASE_URL,
        "logo": {
          "@type": "ImageObject",
          "url": `${BASE_URL}/logo.png`
        },
        "sameAs": [
          "https://github.com/clawdbot/clawdbot",
          "https://discord.gg/u4WYaNs5bC"
        ]
      }
    ]
  })} />
  
  <!-- Clawd Bot 样式 - Preload for critical CSS -->
  <link rel="preload" href="/styles/clawd-bot.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/styles/clawd-bot.css"></noscript>
  
  <!-- Microsoft Clarity Analytics (Delayed 3s for better performance) -->
  <script type="text/javascript">
    // Load Clarity only after page is interactive
    if ('requestIdleCallback' in window) {
      requestIdleCallback(function() {
        setTimeout(function() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "v80wlhr9r6");
        }, 3000);
      }, { timeout: 5000 });
    } else {
      setTimeout(function() {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "v80wlhr9r6");
      }, 3000);
    }
  </script>
  
  <!-- Async CSS loader script -->
  <script is:inline>
    /*! loadCSS. [c]2017 Filament Group, Inc. MIT License */
    (function(w){"use strict";if(!w.loadCSS){w.loadCSS=function(){}}
    var loadCSS=function(href,before,media){var doc=w.document;var ss=doc.createElement("link");var ref;if(before){ref=before}else{var refs=(doc.body||doc.getElementsByTagName("head")[0]).childNodes;ref=refs[refs.length-1];}
    var sheets=doc.styleSheets;ss.rel="stylesheet";ss.href=href;ss.media="only x";
    function ready(cb){if(doc.body){return cb()}setTimeout(function(){ready(cb)})}
    ready(function(){ref.parentNode.insertBefore(ss,before?ref:ref.nextSibling)});var onloadcssdefined=function(cb){var resolvedHref=ss.href;var i=sheets.length;while(i--){if(sheets[i].href===resolvedHref){return cb()}}
    setTimeout(function(){onloadcssdefined(cb)})};ss.onloadcssdefined=onloadcssdefined;onloadcssdefined(function(){if(ss.media!=="all"){ss.media=media||"all"}});return ss};
    w.loadCSS=loadCSS})(window);
  </script>
  
  <style is:global>
    /* 基础重置 - Critical CSS */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      background-color: #050810;
      color: #f0f4ff;
      font-family: 'Satoshi', 'Inter', system-ui, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    /* 滚动条样式 */
    ::-webkit-scrollbar {
      width: 8px;
    }
    
    ::-webkit-scrollbar-track {
      background: #0a0f1a;
    }
    
    ::-webkit-scrollbar-thumb {
      background: #5a6480;
      border-radius: 4px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
      background: #8892b0;
    }
    
    /* 选中文本样式 */
    ::selection {
      background: rgba(255, 77, 77, 0.3);
      color: #f0f4ff;
    }
  </style>
</head>
<body>
  <!-- noscript 内容用于 BingBot -->
  <noscript>
    <div style="padding: 2rem; text-align: center;">
      <h1>Clawd Bot - Personal AI Assistant</h1>
      <p>Clawd Bot is a personal AI assistant that runs on your machine. Control it via WhatsApp, Telegram, Discord, Slack, Signal, or iMessage.</p>
      <p>Features: Persistent Memory, Browser Control, System Access, Skills & Plugins</p>
      <p>Visit our website with JavaScript enabled for the full experience.</p>
    </div>
  </noscript>
  
  <slot />
</body>
</html>

