---
/**
 * ClawdBot 专用布局组件
 * 深色主题 + 品牌风格
 */

interface Props {
  title: string;
  description: string;
  keywords?: string;
  locale?: string;
  path?: string;
}

const { 
  title, 
  description, 
  keywords = 'ClawdBot, ClawdBot AI, ClawdBot assistant, ClawdBot personal AI, ClawdBot WhatsApp, ClawdBot Telegram, ClawdBot automation, ClawdBot open source, ClawdBot download, ClawdBot features, ClawdBot use cases, ClawdBot integrations, ClawdBot setup, ClawdBot tutorial, ClawdBot guide',
  locale = 'en',
  path = ''
} = Astro.props;

const BASE_URL = 'https://clawdbot.free';

// 多语言路径处理
function getHreflangPath(pagePath: string, lang: string): string {
  if (lang === 'en') {
    return pagePath || '/';
  }
  return `/${lang}${pagePath ? `/${pagePath}` : ''}`;
}

// 生成 canonical URL - 考虑语言路径
// 如果 path 为空，根据 locale 生成正确的首页 URL
const canonicalUrl = path 
  ? `${BASE_URL}/${path.replace(/^\//, '')}` 
  : `${BASE_URL}${getHreflangPath('', locale)}`;
---

<!DOCTYPE html>
<html lang={locale === 'zh-tw' ? 'zh-TW' : (locale === 'zh' ? 'zh-CN' : locale)}>
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="ClawdBot">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050810">
  
  <!-- DNS Prefetch and Preconnect for external resources -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://api.fontshare.com">
  <link rel="dns-prefetch" href="https://www.clarity.ms">
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Preconnect to Fontshare -->
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  
  <!-- Preload hero font CSS for faster LCP -->
  <link rel="preload" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap" as="style">
  
  <!-- Fonts: non-render-blocking (media=print then all) for better FCP/LCP -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"></noscript>
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap"></noscript>
  
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="ClawdBot">
  <meta name="robots" content="index, follow">
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${BASE_URL}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={locale.replace('-', '_')}>
  <meta property="og:site_name" content="ClawdBot">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${BASE_URL}/og-image.png`}>
  
  <!-- Hreflang tags -->
  <link rel="alternate" hreflang="en" href={`${BASE_URL}${getHreflangPath(path, 'en')}`}>
  <link rel="alternate" hreflang="zh-CN" href={`${BASE_URL}${getHreflangPath(path, 'zh')}`}>
  <link rel="alternate" hreflang="zh-TW" href={`${BASE_URL}${getHreflangPath(path, 'zh-tw')}`}>
  <link rel="alternate" hreflang="ja" href={`${BASE_URL}${getHreflangPath(path, 'ja')}`}>
  <link rel="alternate" hreflang="ko" href={`${BASE_URL}${getHreflangPath(path, 'ko')}`}>
  <link rel="alternate" hreflang="es" href={`${BASE_URL}${getHreflangPath(path, 'es')}`}>
  <link rel="alternate" hreflang="de" href={`${BASE_URL}${getHreflangPath(path, 'de')}`}>
  <link rel="alternate" hreflang="fr" href={`${BASE_URL}${getHreflangPath(path, 'fr')}`}>
  <link rel="alternate" hreflang="pt" href={`${BASE_URL}${getHreflangPath(path, 'pt')}`}>
  <link rel="alternate" hreflang="ru" href={`${BASE_URL}${getHreflangPath(path, 'ru')}`}>
  <link rel="alternate" hreflang="hi" href={`${BASE_URL}${getHreflangPath(path, 'hi')}`}>
  <link rel="alternate" hreflang="x-default" href={BASE_URL}>
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@id": `${BASE_URL}/#website`,
        "@type": "WebSite",
        "inLanguage": locale === 'zh-tw' ? 'zh-TW' : (locale === 'zh' ? 'zh-CN' : 'en-US'),
        "name": "ClawdBot",
        "url": BASE_URL,
        "description": "Personal AI assistant that runs on your machine. Control it via WhatsApp, Telegram, Discord and more.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${BASE_URL}/?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@id": `${canonicalUrl}#webpage`,
        "@type": "WebPage",
        "name": title,
        "url": canonicalUrl,
        "description": description,
        "isPartOf": {
          "@id": `${BASE_URL}/#website`
        },
        "about": {
          "@type": "SoftwareApplication",
          "name": "ClawdBot",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "macOS, Windows, Linux",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      },
      {
        "@type": "Organization",
        "@id": `${BASE_URL}/#organization`,
        "name": "ClawdBot",
        "url": BASE_URL,
        "logo": {
          "@type": "ImageObject",
          "url": `${BASE_URL}/logo.png`
        },
        "sameAs": [
          "https://github.com/clawdbot/clawdbot",
          "https://discord.gg/u4WYaNs5bC"
        ]
      }
    ]
  })} />
  
  <!-- ClawdBot 样式 - Preload for critical CSS -->
  <link rel="preload" href="/styles/clawd-bot.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/styles/clawd-bot.css"></noscript>
  
  <!-- Microsoft Clarity Analytics (Delayed 3s for better performance) -->
  <script type="text/javascript">
    // Load Clarity only after page is interactive
    if ('requestIdleCallback' in window) {
      requestIdleCallback(function() {
        setTimeout(function() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "v97dt9ghku");
        }, 3000);
      }, { timeout: 5000 });
    } else {
      setTimeout(function() {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "v97dt9ghku");
      }, 3000);
    }
  </script>
  
  <!-- Async CSS loader script -->
  <script is:inline>
    /*! loadCSS. [c]2017 Filament Group, Inc. MIT License */
    (function(w){"use strict";if(!w.loadCSS){w.loadCSS=function(){}}
    var loadCSS=function(href,before,media){var doc=w.document;var ss=doc.createElement("link");var ref;if(before){ref=before}else{var refs=(doc.body||doc.getElementsByTagName("head")[0]).childNodes;ref=refs[refs.length-1];}
    var sheets=doc.styleSheets;ss.rel="stylesheet";ss.href=href;ss.media="only x";
    function ready(cb){if(doc.body){return cb()}setTimeout(function(){ready(cb)})}
    ready(function(){ref.parentNode.insertBefore(ss,before?ref:ref.nextSibling)});var onloadcssdefined=function(cb){var resolvedHref=ss.href;var i=sheets.length;while(i--){if(sheets[i].href===resolvedHref){return cb()}}
    setTimeout(function(){onloadcssdefined(cb)})};ss.onloadcssdefined=onloadcssdefined;onloadcssdefined(function(){if(ss.media!=="all"){ss.media=media||"all"}});return ss};
    w.loadCSS=loadCSS})(window);
  </script>
  
  <style is:global>
    /* 基础重置 - Critical CSS */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      background-color: #050810;
      color: #f0f4ff;
      font-family: 'Satoshi', 'Inter', system-ui, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    /* 滚动条样式 */
    ::-webkit-scrollbar {
      width: 8px;
    }
    
    ::-webkit-scrollbar-track {
      background: #0a0f1a;
    }
    
    ::-webkit-scrollbar-thumb {
      background: #5a6480;
      border-radius: 4px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
      background: #8892b0;
    }
    
    /* 选中文本样式 */
    ::selection {
      background: rgba(255, 77, 77, 0.3);
      color: #f0f4ff;
    }
  </style>
  <!-- Critical above-the-fold: variables + header + hero for FCP/LCP -->
  <style is:global>
    :root {
      --bg-deep: #050810;
      --bg-surface: #0a0f1a;
      --bg-elevated: #111827;
      --coral-bright: #ff4d4d;
      --coral-mid: #e63946;
      --cyan-bright: #00e5cc;
      --text-primary: #f0f4ff;
      --text-secondary: #8892b0;
      --border-subtle: rgba(136, 146, 176, 0.15);
      --border-accent: rgba(255, 77, 77, 0.3);
      --font-display: "Clash Display", "Inter", system-ui, sans-serif;
      --font-body: "Satoshi", "Inter", system-ui, sans-serif;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-full: 9999px;
      --transition-fast: 150ms ease;
      --transition-normal: 300ms ease;
      --shadow-glow-coral: 0 0 20px rgba(255, 77, 77, 0.3);
      --shadow-glow-cyan: 0 0 20px rgba(0, 229, 204, 0.3);
    }
    .clawd-container { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-lg); }
    .clawd-btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-sm); padding: var(--space-md) var(--space-xl); border-radius: var(--radius-lg); font-family: var(--font-body); font-weight: 500; font-size: 1rem; cursor: pointer; transition: all var(--transition-normal); text-decoration: none; border: none; }
    .clawd-btn-primary { background: linear-gradient(135deg, var(--coral-bright), var(--coral-mid)); color: white; box-shadow: var(--shadow-glow-coral); }
    .clawd-btn-secondary { background: var(--bg-elevated); color: var(--text-primary); border: 1px solid var(--border-subtle); }
    .clawd-header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(5, 8, 16, 0.9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-subtle); }
    .clawd-nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .clawd-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--text-primary); font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; }
    .clawd-logo-icon { font-size: 1.5rem; }
    .clawd-nav-links { display: flex; gap: 2rem; }
    .clawd-nav-link { color: var(--text-secondary); text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .clawd-nav-right { display: flex; align-items: center; gap: 1rem; }
    .clawd-lang-btn { display: flex; align-items: center; gap: 0.25rem; padding: 0.5rem 0.75rem; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-secondary); font-size: 0.875rem; cursor: pointer; }
    .clawd-github-link { display: flex; align-items: center; color: var(--text-secondary); }
    .clawd-menu-btn { display: none; padding: 0.5rem; background: none; border: none; color: var(--text-secondary); cursor: pointer; }
    .clawd-lang-dropdown { position: absolute; top: 100%; right: 0; margin-top: 0.5rem; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 0.5rem; min-width: 100px; opacity: 0; visibility: hidden; }
    .clawd-lang-selector:hover .clawd-lang-dropdown { opacity: 1; visibility: visible; }
    .clawd-lang-option { display: block; padding: 0.5rem 0.75rem; color: var(--text-secondary); text-decoration: none; font-size: 0.875rem; border-radius: 0.375rem; }
    .clawd-mobile-menu { display: none; padding: 1rem; background: var(--bg-surface); border-top: 1px solid var(--border-subtle); }
    .clawd-mobile-link { display: block; padding: 0.75rem 0; color: var(--text-secondary); text-decoration: none; font-size: 1rem; border-bottom: 1px solid var(--border-subtle); }
    @media (max-width: 768px) { .clawd-nav-links { display: none; } .clawd-menu-btn { display: flex; } .clawd-mobile-menu.active { display: block; } }
    .home-hero { position: relative; min-height: 90vh; display: flex; align-items: center; padding: 6rem 0 4rem; overflow: hidden; }
    .home-hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at top center, rgba(255, 77, 77, 0.12) 0%, transparent 50%), radial-gradient(ellipse at bottom right, rgba(0, 229, 204, 0.08) 0%, transparent 50%); pointer-events: none; }
    .home-hero-content { position: relative; text-align: center; max-width: 720px; margin: 0 auto; }
    .home-hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border-accent); border-radius: var(--radius-full); color: var(--coral-bright); font-size: 0.875rem; font-weight: 500; margin-bottom: 1.5rem; }
    .home-hero-title { font-family: var(--font-display); font-size: clamp(3rem, 10vw, 5rem); font-weight: 700; line-height: 1.1; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.02em; }
    .home-hero-subtitle { font-family: var(--font-display); font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; color: var(--coral-bright); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem; }
    .home-hero-description { font-size: 1.1rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem; }
    .home-hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
    .home-hero-cta .clawd-btn { min-width: 160px; }
    @media (max-width: 640px) { .home-hero { padding: 5rem 0 3rem; } .home-hero-cta { flex-direction: column; align-items: center; } .home-hero-cta .clawd-btn { width: 100%; max-width: 280px; } }
  </style>
</head>
<body>
  <!-- noscript 内容用于 BingBot：H1 仅在 slot 的 Hero 中，此处 H2/H3 树状结构 -->
  <noscript>
    <section style="padding: 2rem 1.5rem; max-width: 720px; margin: 0 auto;">
      <h2>ClawdBot: Personal AI Assistant That Actually Does Things</h2>
      <p>ClawdBot is an open-source personal AI assistant that runs locally. Control it via WhatsApp, Telegram, Discord and more. It automates email, calendar, flight check-in, browsing, and real tasks—not just chat.</p>
      <h2>What is ClawdBot?</h2>
      <p>ClawdBot is a self-hosted, locally-running AI assistant that can perform real tasks—emails, calendar, flight check-in, browsing, and more—not just give advice. Unlike typical chatbots, it actually executes actions on your behalf.</p>
      <h2>Is ClawdBot free? Is it safe?</h2>
      <h3>Free</h3>
      <p>ClawdBot is open source (MIT) and self-hosted for free. You may pay for hardware and API tokens when using cloud models.</p>
      <h3>Safe</h3>
      <p>Your data stays on your machine. See <a href="https://docs.clawd.bot/security" title="ClawdBot Security">Security</a> in our docs.</p>
      <h2>ClawdBot install and docs</h2>
      <h3>Quick install</h3>
      <p>One-line install: <code>npm install -g openclaw@latest</code>.</p>
      <h3>Documentation</h3>
      <p>Full documentation: <a href="https://docs.clawd.bot" title="ClawdBot Documentation">docs.clawd.bot</a> — Getting started, Wizard, Setup, Install &amp; update.</p>
    </section>
  </noscript>
  
  <slot />
</body>
</html>

