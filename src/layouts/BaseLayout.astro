---
import '../styles/global.css';
import { t, type Locale, locales } from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  keywords: string;
  locale: Locale;
  path?: string;
  canonicalOverride?: string; // 用于重复内容页面指向主版本
}

const { title, description, keywords, locale, path = '', canonicalOverride } = Astro.props;
const BASE_URL = 'https://grokapi.org';

function getCanonicalUrl(locale: Locale, path: string) {
  const basePath = path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`);
  if (locale === 'en') {
    return `${BASE_URL}${basePath}`;
  }
  return `${BASE_URL}/${locale}${basePath}`;
}

const canonicalUrl = canonicalOverride || getCanonicalUrl(locale, path);
---

<!DOCTYPE html>
<html lang={locale === 'zh-tw' ? 'zh-TW' : locale}>
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Grok API">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Bing Webmaster Verification -->
  <meta name="msvalidate.01" content="368D6A900DB44C9911D6B04BCF958D06">
  
  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="zs5SjVPs2eZJlHUYjxW-i5QsItNV1UT1kB9_96MdeTU">
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
  
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Grok.api">
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${BASE_URL}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={locale.replace('-', '_')}>
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalUrl}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={`${BASE_URL}/og-image.png`}>
  
  <!-- Hreflang tags -->
  <link rel="alternate" hreflang="en" href={`${BASE_URL}${path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`)}`}>
  <link rel="alternate" hreflang="zh-CN" href={`${BASE_URL}/zh${path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`)}`}>
  <link rel="alternate" hreflang="zh-TW" href={`${BASE_URL}/zh-tw${path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`)}`}>
  <link rel="alternate" hreflang="zh-HK" href={`${BASE_URL}/zh-tw${path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`)}`}>
  <link rel="alternate" hreflang="x-default" href={`${BASE_URL}${path === '' ? '/' : (path.endsWith('/') ? path : `${path}/`)}`}>
</head>
<body class="min-h-screen bg-white">
  <slot />
</body>
</html>
