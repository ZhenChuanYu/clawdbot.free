---
/**
 * Clawd Bot 首页 (한국어)
 */
import ClawdBotLayout from '../../../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../../../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotHero from '../../../components/clawd-bot/ClawdBotHero.astro';
import ClawdBotFeatures from '../../../components/clawd-bot/ClawdBotFeatures.astro';
import ClawdBotUseCases from '../../../components/clawd-bot/ClawdBotUseCases.astro';
import ClawdBotIntegrations from '../../../components/clawd-bot/ClawdBotIntegrations.astro';
import ClawdBotQuickStart from '../../../components/clawd-bot/ClawdBotQuickStart.astro';
import ClawdBotFAQ from '../../../components/clawd-bot/ClawdBotFAQ.astro';
import ClawdBotFooter from '../../../components/clawd-bot/ClawdBotFooter.astro';

const locale = 'ko';
const title = 'Clawd Bot - 실제로 일을 하는 개인 AI 어시스턴트';
const description = 'Clawd Bot은 당신의 컴퓨터에서 실행되는 오픈소스 개인 AI 어시스턴트입니다. WhatsApp, Telegram, Discord 등으로 제어하세요. 이메일, 캘린더, 항공편 체크인, 스마트 홈 등 모든 것을 자동화합니다.';
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path="ko"
>
  <ClawdBotHeader locale={locale} />
  <main>
    <ClawdBotHero locale={locale} />
    <ClawdBotFeatures locale={locale} />
    <ClawdBotUseCases locale={locale} />
    <ClawdBotIntegrations locale={locale} />
    <ClawdBotQuickStart locale={locale} />
    <ClawdBotFAQ locale={locale} />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>

