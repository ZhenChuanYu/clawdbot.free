---
/**
 * Clawd Bot 首页 (Français)
 */
import ClawdBotLayout from '../../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotFooter from '../../components/clawd-bot/ClawdBotFooter.astro';
import HomeHero from '../../components/clawd-bot/home/HomeHero.astro';
import HomeArticle from '../../components/clawd-bot/home/HomeArticle.astro';

const locale = 'fr';
const title = "Clawd Bot - Téléchargement et installation gratuits";
const description = "Clawd Bot est un assistant IA personnel open source qui fonctionne sur votre machine. Contrôlez-le via WhatsApp, Telegram, Discord et plus. Automatisez emails, calendrier, enregistrement de vol, maison connectée et tout le reste.";
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path=""
>
  <ClawdBotHeader locale={locale} />
  <main>
    <HomeHero locale={locale} />
    <HomeArticle locale={locale} />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>
