---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LowCostPlatforms from '../../components/LowCostPlatforms.astro';
import { tPlatforms } from '../../i18n/grok-api-free-translations';

const locale = 'fr';
---

<BaseLayout 
  title={tPlatforms(locale, 'seo_title')}
  description={tPlatforms(locale, 'seo_description')}
  keywords={tPlatforms(locale, 'seo_keywords')}
  locale={locale}
  path="grok-api-free"
>
  <Header locale={locale} />
  <main class="pt-16">
    <LowCostPlatforms locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>

