---
/**
 * ClawdBot 首页 (英文) — 现代简洁风格
 */
import ClawdBotLayout from '../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotFooter from '../components/clawd-bot/ClawdBotFooter.astro';
import HomeHero from '../components/clawd-bot/home/HomeHero.astro';
import HomeFeatures from '../components/clawd-bot/home/HomeFeatures.astro';
import HomeInstall from '../components/clawd-bot/home/HomeInstall.astro';
import HomeAbout from '../components/clawd-bot/home/HomeAbout.astro';

const locale = 'en';
const title = 'OpenClaw (ClawdBot) | Local Native AI Agent';
const description = 'Open-source personal AI agent with Voice Mode, Live Canvas & ClawHub. Runs locally on macOS, Windows, and Linux. Connects to WhatsApp, Telegram, and 12+ platforms.';
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path=""
>
  <ClawdBotHeader locale={locale} />
  <main>
    <HomeHero locale={locale} />
    <HomeFeatures />
    <HomeInstall />
    <HomeAbout />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>
