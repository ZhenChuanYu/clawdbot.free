---
/**
 * ClawdBot 首页 (Русский)
 */
import ClawdBotLayout from '../../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotFooter from '../../components/clawd-bot/ClawdBotFooter.astro';
import HomeHero from '../../components/clawd-bot/home/HomeHero.astro';
import HomeFeatures from '../../components/clawd-bot/home/HomeFeatures.astro';
import HomeInstall from '../../components/clawd-bot/home/HomeInstall.astro';
import HomeAbout from '../../components/clawd-bot/home/HomeAbout.astro';
// import HomeArticle from '../../components/clawd-bot/home/HomeArticle.astro';

const locale = 'ru';
const title = 'OpenClaw(ClawdBot) - ИИ, который действительно делает дела за вас';
const description = 'OpenClaw (ранее ClawdBot) — это персональный ИИ-агент с открытым исходным кодом с голосовым режимом, живым холстом и экосистемой ClawHub. Работает локально на macOS, Windows и Linux. Подключается к WhatsApp, Telegram и более 12 платформам.';
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path=""
>
  <ClawdBotHeader locale={locale} />
  <main>
    <HomeHero locale={locale} />
    <HomeFeatures locale={locale} />
    <HomeInstall locale={locale} />
    <HomeAbout locale={locale} />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>
