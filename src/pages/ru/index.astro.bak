---
/**
 * ClawdBot 首页 (Русский)
 */
import ClawdBotLayout from '../../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotFooter from '../../components/clawd-bot/ClawdBotFooter.astro';
import HomeHero from '../../components/clawd-bot/home/HomeHero.astro';
import HomeArticle from '../../components/clawd-bot/home/HomeArticle.astro';

const locale = 'ru';
const title = 'ClawdBot - Бесплатная загрузка и установка';
const description = 'ClawdBot — это персональный ИИ-ассистент с открытым кодом, работающий на вашем компьютере. Управляйте через WhatsApp, Telegram, Discord и другие. Автоматизируйте почту, календарь, регистрацию на рейс, умный дом и всё остальное.';
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path=""
>
  <ClawdBotHeader locale={locale} />
  <main>
    <HomeHero locale={locale} />
    <HomeArticle locale={locale} />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>
