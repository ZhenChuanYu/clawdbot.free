---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermsOfService from '../../components/TermsOfService.astro';

const locale = 'zh-tw';
---

<BaseLayout 
  title="服務條款 - Grok API"
  description="Grok API 平台服務條款"
  keywords="服務條款, grok api, 用戶協議"
  locale={locale}
  path="/terms-of-service"
  canonicalOverride="https://clawd-bot.com/terms-of-service/"
>
  <Header locale={locale} />
  <main class="pt-16">
    <TermsOfService locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
