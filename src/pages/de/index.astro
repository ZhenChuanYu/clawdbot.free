---
/**
 * Clawd Bot 首页 (Deutsch)
 */
import ClawdBotLayout from '../../layouts/ClawdBotLayout.astro';
import ClawdBotHeader from '../../components/clawd-bot/ClawdBotHeader.astro';
import ClawdBotFooter from '../../components/clawd-bot/ClawdBotFooter.astro';
import HomeHero from '../../components/clawd-bot/home/HomeHero.astro';
import HomeWhatIs from '../../components/clawd-bot/home/HomeWhatIs.astro';
import HomeWhySpecial from '../../components/clawd-bot/home/HomeWhySpecial.astro';
import HomeFreeSafe from '../../components/clawd-bot/home/HomeFreeSafe.astro';
import HomeInstallSetup from '../../components/clawd-bot/home/HomeInstallSetup.astro';
import HomeDocs from '../../components/clawd-bot/home/HomeDocs.astro';
import HomeApp from '../../components/clawd-bot/home/HomeApp.astro';

const locale = 'de';
const title = 'Clawd Bot - Persönlicher KI-Assistent Der Wirklich Dinge Tut';
const description = 'Clawd Bot ist ein Open-Source persönlicher KI-Assistent, der auf Ihrem Rechner läuft. Steuern Sie ihn über WhatsApp, Telegram, Discord und mehr. Automatisieren Sie E-Mails, Kalender, Flug-Check-in, Smart Home und alles andere.';
---

<ClawdBotLayout 
  title={title} 
  description={description}
  locale={locale}
  path=""
>
  <ClawdBotHeader locale={locale} />
  <main>
    <HomeHero locale={locale} />
    <HomeWhatIs locale={locale} />
    <HomeWhySpecial locale={locale} />
    <HomeFreeSafe locale={locale} />
    <HomeInstallSetup locale={locale} />
    <HomeDocs locale={locale} />
    <HomeApp locale={locale} />
  </main>
  <ClawdBotFooter locale={locale} />
</ClawdBotLayout>
