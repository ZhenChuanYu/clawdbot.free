---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TermsOfService from '../components/TermsOfService.astro';

const locale = 'en';
---

<BaseLayout 
  title="Terms of Service - Grok API"
  description="Terms of Service for Grok API platform"
  keywords="terms of service, grok api, user agreement"
  locale={locale}
  path="/terms-of-service"
>
  <Header locale={locale} />
  <main class="pt-16">
    <TermsOfService locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
