---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermsOfService from '../../components/TermsOfService.astro';

const locale = 'zh';
---

<BaseLayout 
  title="服务条款 - Grok API"
  description="Grok API 平台服务条款"
  keywords="服务条款, grok api, 用户协议"
  locale={locale}
  path="/terms-of-service"
  canonicalOverride="https://grokapi.org/terms-of-service/"
>
  <Header locale={locale} />
  <main class="pt-16">
    <TermsOfService locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
