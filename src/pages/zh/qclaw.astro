<style>
  .qclaw-hero {
    padding: 8rem 0 5rem;
    background: radial-gradient(ellipse at top center, rgba(255, 77, 77, 0.1) 0%, transparent 60%),
                radial-gradient(ellipse at bottom left, rgba(0, 229, 204, 0.06) 0%, transparent 50%);
    text-align: center;
  }
  .qclaw-hero-inner { max-width: 700px; margin: 0 auto; }
  .qclaw-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-full);
    color: var(--coral-bright);
    font-size: 0.85rem; font-weight: 500;
    margin-bottom: 1.5rem;
  }
  .qclaw-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700; line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .qclaw-subtitle {
    font-size: 1.2rem; font-weight: 500;
    color: var(--coral-bright);
    margin-bottom: 1.25rem;
  }
  .qclaw-desc {
    font-size: 1.05rem; color: var(--text-secondary);
    line-height: 1.75; margin-bottom: 2rem;
  }
  .qclaw-desc strong { color: var(--text-primary); }
  .qclaw-hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .qclaw-section { padding: 5rem 0; }
  .qclaw-section-alt { background: var(--bg-surface); }
  .qclaw-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700; color: var(--text-primary);
    margin-bottom: 1rem; text-align: center;
  }
  .qclaw-section-lead {
    font-size: 1.05rem; color: var(--text-secondary);
    line-height: 1.75; text-align: center;
    max-width: 680px; margin: 0 auto 3rem;
  }

  .qclaw-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem; margin-top: 3rem;
  }
  .qclaw-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: border-color var(--transition-normal);
  }
  .qclaw-card:hover { border-color: var(--border-accent); }
  .qclaw-card-icon { font-size: 2rem; margin-bottom: 1rem; }
  .qclaw-card h3 { font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
  .qclaw-card p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; }

  .qclaw-steps { display: flex; flex-direction: column; gap: 1.5rem; max-width: 680px; margin: 3rem auto 0; }
  .qclaw-step { display: flex; gap: 1.5rem; align-items: flex-start; }
  .qclaw-step-num {
    flex-shrink: 0;
    width: 2.5rem; height: 2.5rem;
    background: linear-gradient(135deg, var(--coral-bright), var(--coral-mid));
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; color: white;
  }
  .qclaw-step-body h3 { font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.4rem; }
  .qclaw-step-body p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; }

  .qclaw-compare {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1.5rem; margin-top: 2.5rem;
  }
  .qclaw-compare-col {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .qclaw-compare-header {
    padding: 1rem 1.5rem;
    font-weight: 700; font-size: 1.1rem;
    text-align: center;
  }
  .qclaw-compare-header-qclaw { background: rgba(255, 77, 77, 0.15); color: var(--coral-bright); }
  .qclaw-compare-header-openclaw { background: rgba(0, 229, 204, 0.1); color: var(--cyan-bright); }
  .qclaw-compare-list { list-style: none; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .qclaw-compare-list li { font-size: 0.95rem; color: var(--text-secondary); padding-left: 1.25rem; position: relative; }
  .qclaw-compare-list li::before { content: '✓'; position: absolute; left: 0; color: var(--coral-bright); font-weight: 700; }
  .qclaw-compare-note {
    text-align: center; margin-top: 2rem;
    font-size: 0.95rem; color: var(--text-secondary);
  }
  .qclaw-compare-note a { color: var(--coral-bright); text-decoration: none; }
  .qclaw-compare-note a:hover { text-decoration: underline; }

  .qclaw-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem; margin-top: 3rem;
  }
  .qclaw-feature {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
